# Database (pooler for app, direct for migrations)
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL_MIGRATE=postgres://postgres:password@db.xxxx.supabase.co:5432/postgres

# Admin auth — comma-separated user:bcryptHash pairs
# Generate hash: bun run hash-password
ADMIN_USERS=admin:$2b$12$...

# Session — random 32+ char secret; rotate to log everyone out
SESSION_SECRET=change-me-to-a-random-32-char-string

# Supabase Storage via S3 API
S3_ENDPOINT=https://xxxx.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET=microsites

# Public URL prefix for storage bucket (must be public bucket)
PUBLIC_STORAGE_URL=https://xxxx.supabase.co/storage/v1/object/public/microsites
